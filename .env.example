# Model provider. Set one key; the first one present is used (groq, nvidia, cerebras, then anthropic).
# Force a choice with IA_PROVIDER=groq|nvidia|cerebras|ollama|openai_compatible|anthropic.
# The published results used: ANTHROPIC_API_KEY, IA_PROVIDER=anthropic, IA_MODEL_STRONG=claude-sonnet-5-5, IA_MODEL_FAST=claude-sonnet-5-5
ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# NVIDIA_API_KEY=                     # build.nvidia.com, OpenAI-compatible
# CEREBRAS_API_KEY=
#
# A local model, no key and no cost (needs about 14 GB of RAM for gpt-oss:20b):
#   brew install ollama && OLLAMA_CONTEXT_LENGTH=32768 ollama serve      (in one terminal)
#   ollama pull gpt-oss:20b                                              (in another)
# IA_PROVIDER=ollama
#
# Any other OpenAI-compatible endpoint:
# IA_PROVIDER=openai_compatible
# IA_BASE_URL=https://host/v1
# IA_API_KEY=

# Optional: models per tier. Defaults: openai/gpt-oss-120b for both on Groq and NVIDIA,
# gpt-oss:20b on Ollama, claude-opus-5-5 (strong) and claude-sonnet-5-5 (fast) on Anthropic.
# IA_MODEL_STRONG=                    # reasoning, critic, single-agent baseline
# IA_MODEL_FAST=                      # specialists, reporting, eval judge
# IA_MAX_OUTPUT_TOKENS=8000           # output cap per model call
# IA_RATE_WAIT_S=900                  # Groq: longest total wait on rate limits per call
# IA_MAX_COST_USD=2.5                # stop one investigation at this many USD of model usage
# IA_LLM_TIMEOUT_S=240                # Anthropic: give up on a model call after this long and retry
# IA_LLM_FALLBACKS=1                  # Anthropic: server-side fallback if a request is declined

# Optional: real connectors (not needed for the synthetic dataset).
# A reference such as secret://sumo/prod#access_key reads SUMO_PROD_ACCESS_KEY.
# SUMO_PROD_ACCESS_ID=
# SUMO_PROD_ACCESS_KEY=
# NEWRELIC_PROD_USER_KEY=
# NEW_RELIC_ACCOUNT_ID=
# GITHUB_READONLY_TOKEN=
